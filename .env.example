# =================================================================
# FacturaFlow - variables de entorno
# Copia este archivo a .env (que NO se versiona) y reemplaza cada
# CAMBIAME por un valor real. Nunca subas el .env a Git.
# =================================================================

# --- PostgreSQL: superusuario del contenedor (solo administración) ---
POSTGRES_SUPERUSER=CAMBIAME
POSTGRES_SUPERUSER_PASSWORD=CAMBIAME

# --- Servicio invoicing: contraseña de invoicing_user (base invoicing_db) ---
INVOICING_DB_PASSWORD=CAMBIAME

# --- Factus (sandbox). Aún no se usan; se usarán en el servicio invoicing ---
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=CAMBIAME
FACTUS_CLIENT_SECRET=CAMBIAME
FACTUS_USERNAME=CAMBIAME
FACTUS_PASSWORD=CAMBIAME
