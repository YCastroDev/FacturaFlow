# =================================================================
# FacturaFlow - variables de entorno
# Copia este archivo a .env (que NO se versiona) y reemplaza cada
# CAMBIAME por un valor real. Nunca subas el .env a Git.
# =================================================================

# --- PostgreSQL: superusuario del contenedor (solo administración) ---
POSTGRES_SUPERUSER=CAMBIAME
POSTGRES_SUPERUSER_PASSWORD=CAMBIAME

# --- Servicio invoicing: contraseña de invoicing_user (base invoicing_db) ---
INVOICING_DB_PASSWORD=CAMBIAME

# --- Servicio catalog: contraseña de catalog_user (base catalog_db) ---
CATALOG_DB_PASSWORD=CAMBIAME

# --- Servicio sales: contraseña de sales_user (base sales_db) ---
SALES_DB_PASSWORD=CAMBIAME
# Opcional: URL de catalog vista desde sales. Vacío = http://catalog:8080 (la red de docker compose).
SALES_CATALOG_BASE_URL=
# Contraseña del usuario "sales" de RabbitMQ (solo puede publicar en el exchange sales.events).
SALES_RABBITMQ_PASSWORD=CAMBIAME

# --- RabbitMQ: administrador (consola http://localhost:15672 y script de init; ADR 0013) ---
RABBITMQ_ADMIN_USER=CAMBIAME
RABBITMQ_ADMIN_PASSWORD=CAMBIAME

# --- Servicio invoicing: contraseña del usuario "invoicing" de RabbitMQ (consume SaleConfirmed; ADR 0014) ---
INVOICING_RABBITMQ_PASSWORD=CAMBIAME

# --- Servicio invoicing: proveedor de facturación electrónica ---
# fake = simulado (sin credenciales); factus = sandbox real de Factus (usa las FACTUS_*).
INVOICING_PROVIDER=fake
# Opcional (solo proveedor falso): cuántas emisiones fallan antes de funcionar con SIMULAR_FALLA_TEMPORAL
# en la observación. Vacío = 4 (los intentos del consumidor de eventos: la venta llega a la DLQ; ADR 0014).
INVOICING_FAKE_TEMPORARY_FAILURES=

# --- Factus (sandbox). Solo se usan con INVOICING_PROVIDER=factus ---
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=CAMBIAME
FACTUS_CLIENT_SECRET=CAMBIAME
FACTUS_USERNAME=CAMBIAME
FACTUS_PASSWORD=CAMBIAME
# true = Factus envía la factura al correo del cliente. En el sandbox, déjelo en false.
FACTUS_SEND_EMAIL=false
# Opcional: id del rango de numeración. Vacío = el rango de facturación por defecto de la cuenta.
FACTUS_NUMBERING_RANGE_ID=
# Obligatorio con Factus: id del rango de numeración de las notas crédito (no es un secreto).
# En el sandbox compartido hay dos: 390 (prefijo NC) y 1776 (CRTE). Vea GET /v2/numbering-ranges.
FACTUS_CREDIT_NOTE_NUMBERING_RANGE_ID=
